# Application
APP_NAME="Backend API"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:8081,http://127.0.0.1:8081,http://localhost:3000"

# MySQL Database Configuration
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="your_password_here"
DB_NAME="coconut_db"

# Or provide full Database URL directly (overrides DB_* fields above if set):
# DATABASE_URL="mysql+pymysql://root:your_password_here@localhost:3306/coconut_db"

# AWS S3 / Object Storage Configuration (Open Bucket for Media)
AWS_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="your-media-bucket-name"
# S3_CUSTOM_ENDPOINT="" # Optional for MinIO, Cloudflare R2, or localstack (e.g., http://localhost:9000)
# S3_PUBLIC_BASE_URL="https://your-media-bucket-name.s3.amazonaws.com"

# Machine Learning & Processing Directories
TRAINED_MODELS_DIR="trained_models"
PROCESSING_DATA_DIR="processing"
